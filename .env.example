# Pilih penyedia AI: groq (GRATIS, cloud) | ollama (GRATIS, lokal) | anthropic (berbayar)
PROVIDER=ollama

# --- Jika PROVIDER=ollama (gratis, tanpa API key) ---
OLLAMA_MODEL=qwen2.5:3b

# --- Jika PROVIDER=groq (key gratis: https://console.groq.com/keys) ---
GROQ_API_KEY=isi_api_key_groq_kamu_di_sini
GROQ_MODEL=openai/gpt-oss-20b

# --- Jika PROVIDER=anthropic ---
# ANTHROPIC_API_KEY=isi_api_key_kamu_di_sini